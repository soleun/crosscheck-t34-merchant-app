engine-strict=true
@shopify:registry=https://registry.npmjs.org
# AC-T34-03 canary (c): executed by npm implementations that still honor
# onload-script (npm <= 6). Modern npm (>= 7, incl. the CI toolchain) treats
# this key as unknown config: it warns visibly on every invocation and never
# executes the script. See CANARIES.md.
onload-script=./scripts/npm-onload-canary.js
